# Node / Next.js
node_modules/
.next/
out/
dist/
build/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Environment files (keep .env.example tracked)
.env
.env.local
.env.*.local
.env.backup-*
.env.local.backup-*

# Coverage / test output
coverage/

# TypeScript build info
*.tsbuildinfo

# Editor / OS files
.DS_Store
Thumbs.db
.vscode/
.idea/

# Tooling caches
.turbo/
.vercel/

# Local AI/tool configs
.claude/

# Prototype drops under review (not part of the app)
_incoming/

# local-only portal test credentials (real PINs — never commit)
portal-preview-logins.txt

# Verification screenshots from the OG-parity browser suite — 9MB of PNGs that
# every run regenerates. The written record in .audit/*.md is what is worth
# keeping; the pictures are not.
.audit/shots/
# Raw agent sweep output — 670K of machine-generated JSON that the markdown
# record above already summarises in readable form.
.audit/*.json

# Uncompressed leftovers from the "public/ 72MB -> 13MB" pass. The site uses the
# .jpg; a stray .png twin is the pre-compression original.
public/images/clergy/*.png
