{
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "_archive",
    "_incoming",
    "**/* 2.ts",
    "**/* 2.tsx",
    "**/* 3.ts",
    "**/* 3.tsx",
    "**/* 4.ts",
    "**/* 4.tsx",
    "**/* 5.ts",
    "**/* 5.tsx",
    "**/* 6.ts",
    "**/* 6.tsx",
    "**/* 7.ts",
    "**/* 7.tsx",
    "**/* 8.ts",
    "**/* 8.tsx",
    "**/* 9.ts",
    "**/* 9.tsx"
  ]
}
